{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viralprinter.dev/schema/timeline-0.1.json",
  "title": "viralprinter timeline v0.1",
  "description": "Shorts-as-code: a declarative description of one short-form video.",
  "type": "object",
  "required": ["version", "canvas", "beats"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.1",
      "description": "Timeline format version. v0.1 is the only version this build reads."
    },
    "canvas": {
      "type": "object",
      "required": ["resolution", "fps"],
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$",
          "description": "Documentary only; resolution is what gets rendered."
        },
        "resolution": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "minimum": 2, "multipleOf": 2},
          "description": "[width, height] in pixels. Even numbers only: yuv420p has no odd sizes."
        },
        "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240}
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "shot"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["hook", "development", "payoff", "cta", "other"]},
          "t": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0},
            "description": "[start, end] in absolute seconds from the top of the video."
          },
          "shot": {
            "type": "object",
            "required": ["src"],
            "additionalProperties": false,
            "properties": {
              "src": {"type": "string", "minLength": 1},
              "in": {"type": "number", "minimum": 0, "description": "Seconds into src where this beat starts."},
              "framing": {"type": "string"}
            }
          },
          "text": {
            "type": "object",
            "required": ["content"],
            "additionalProperties": false,
            "properties": {
              "content": {"type": "string", "minLength": 1},
              "pos": {"enum": ["top", "center", "bottom"]}
            }
          },
          "cue": {"type": "string", "description": "Direction for the human or model shooting the beat; never rendered."}
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "object",
          "required": ["src"],
          "additionalProperties": false,
          "properties": {
            "src": {"type": "string", "minLength": 1},
            "gain_db": {"type": "number", "minimum": -60, "maximum": 12}
          }
        }
      }
    },
    "subtitles": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["none", "burn"]},
        "src": {"type": "string", "minLength": 1, "description": "Path to an .srt file. Required when mode is burn."}
      }
    },
    "provenance": {
      "type": "object",
      "description": "Free-form origin metadata, e.g. the packet this timeline was cut from."
    }
  }
}
